<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 待开始 -->
  <view wx:if="{{status === 'idle'}}" class="state idle-state">
    <view class="hero">
      <view class="hero-eyebrow">ONE SECOND CHALLENGE</view>
      <view class="hero-title">一秒不差？</view>
      <view class="hero-subtitle">你真的懂一秒吗？</view>
      <view class="target-pill">目标时间 1.000 秒</view>
    </view>

    <view class="card best-card">
      <view class="card-label">个人最佳</view>
      <block wx:if="{{hasBest}}">
        <view class="best-value" wx:if="{{bestDurationText}}">{{bestDurationText}}<text class="unit">秒</text></view>
        <view class="best-value" wx:else>误差 {{bestError}}<text class="unit">ms</text></view>
        <view class="best-detail" wx:if="{{bestDurationText}}">误差 {{bestError}}ms</view>
      </block>
      <view wx:else class="best-empty">还没有挑战记录</view>
      <view class="sync-chip" wx:if="{{cloudEnabled && hasBest && syncText}}">{{syncText}}</view>
    </view>

    <view class="ranking-entry ranking-entry-card" bindtap="onOpenRanking">
      <view class="ranking-entry-icon">🏆</view>
      <view class="ranking-entry-copy">
        <view class="ranking-entry-title">一秒封神榜</view>
        <view class="ranking-entry-note">看看谁最接近 1.000 秒</view>
      </view>
      <view class="ranking-entry-arrow">›</view>
    </view>

    <view class="card rule-card">
      <view class="rule-title">怎么玩</view>
      <view class="rule-text">开始计时后界面不会显示时间。觉得刚好过了一秒，就按下“就现在！”。误差越小，越接近“人体原子钟”。</view>
    </view>

    <view class="footer">
      <button class="primary-btn" bindtap="onStartGame">开始游戏</button>
      <view class="precision-tip">计时基于设备时钟，毫秒结果仅供娱乐</view>
    </view>
  </view>

  <view wx:elif="{{status === 'ready'}}" class="state ready-state">
    <view class="state-kicker">专注 · 放松 · 凭感觉</view>
    <view class="ready-title">准备好了吗？</view>
    <view class="ready-hint">调整好姿势，准备挑战一秒。</view>
    <button class="action-btn ready-btn" bindtap="onStartTiming">开始计时</button>
  </view>

  <view wx:elif="{{status === 'running'}}" class="state running-state">
    <view class="pulse-dot"></view>
    <view class="running-title">凭感觉！</view>
    <view class="running-hint">觉得刚好一秒，就按下</view>
    <button class="action-btn instant-btn" bindtap="onStop">就现在！</button>
  </view>

  <view wx:elif="{{status === 'result'}}" class="state result-state">
    <view class="card result-card">
      <view class="result-label">你按停在</view>
      <view class="result-time">{{durationText}}<text class="time-unit">秒</text></view>
      <view class="result-verdict">只差 {{error}}ms · {{tier}}</view>
      <view class="result-direction">相对目标 {{direction}}</view>

      <view class="best-block">
        <view class="new-best" wx:if="{{isNewBest}}">✦ 新纪录</view>
        <view class="best-line" wx:if="{{hasBest}}">
          <block wx:if="{{bestDurationText}}">个人最佳：{{bestDurationText}} 秒（误差 {{bestError}}ms）</block>
          <block wx:else>个人最佳误差：{{bestError}}ms</block>
        </view>
        <view class="best-line" wx:else>还没有最佳成绩</view>
        <view class="sync-chip" wx:if="{{cloudEnabled && hasBest && syncText}}">{{syncText}}</view>
      </view>

      <view class="invalid-tip" wx:if="{{invalid}}">超出有效范围（0–3000ms），本局不计入最佳成绩</view>
    </view>

    <view class="rank-feedback" wx:if="{{cloudEnabled}}">
      <view class="rank-feedback-header">
        <view class="rank-feedback-title">我的排名</view>
        <view class="rank-feedback-link" bindtap="onOpenRanking">完整榜单 ›</view>
      </view>
      <block wx:if="{{rankStatus === 'ready'}}">
        <view class="rank-feedback-main">
          <text class="rank-feedback-rank">{{rankText}}</text>
          <text class="rank-feedback-percent">{{rankPercentText}}</text>
        </view>
        <view class="rank-feedback-gap">{{rankGapText}}</view>
        <view class="rank-feedback-best">{{rankBestText}}</view>
        <view class="rank-feedback-only" wx:if="{{rankOnlyOne}}">目前只有一名上榜玩家</view>
      </block>
      <view wx:elif="{{rankStatus === 'loading'}}" class="rank-feedback-muted">排名计算中…</view>
      <view wx:elif="{{rankStatus === 'pending'}}" class="rank-feedback-muted">排名待同步，稍后刷新</view>
      <view wx:else class="rank-feedback-muted">
        {{rankUnavailableText || '排名暂不可用'}}
        <text class="rank-retry" wx:if="{{canRetryRank}}" bindtap="onRetryRank">重试</text>
      </view>
    </view>

    <view class="footer">
      <button class="primary-btn" bindtap="onRestart">再来一局</button>
      <button class="secondary-btn share-btn" open-type="share" bindtap="onShareTap">分享战绩</button>
      <view class="ranking-entry result-ranking-entry" bindtap="onOpenRanking">查看一秒封神榜 <text>›</text></view>
    </view>
  </view>
</view>
