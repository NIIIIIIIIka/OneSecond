/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.state {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ---------- 通用 ---------- */

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.04);
}

.card-label {
  font-size: 26rpx;
  color: #8a8f99;
}

.target-pill {
  display: inline-block;
  margin-top: 32rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2f80ed;
  background: rgba(47, 128, 237, 0.1);
}

.footer {
  margin-top: auto;
  padding-top: 48rpx;
}

.primary-btn {
  width: 100%;
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.primary-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.precision-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
}

/* ---------- idle ---------- */

.hero {
  padding: 16rpx 8rpx 44rpx;
}

.hero-title {
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #111111;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 32rpx;
  color: #8a8f99;
}

.best-card {
  margin-bottom: 24rpx;
}

.best-value {
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #111111;
}

.best-value .unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #8a8f99;
}

.best-detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.best-empty {
  margin-top: 14rpx;
  font-size: 32rpx;
  color: #b0b4bb;
}

.sync-chip {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #8a8f99;
  font-size: 22rpx;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.rule-text {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #6b7280;
}

/* ---------- ready ---------- */

.ready-state {
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ready-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #111111;
}

.ready-hint {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #8a8f99;
}

/* ---------- running ---------- */

.running-state {
  align-items: center;
  justify-content: center;
  text-align: center;
}

.running-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #111111;
}

.running-hint {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #8a8f99;
}

.action-btn {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  margin-top: 120rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.action-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.instant-btn {
  background: #ff4d4f;
}

.ready-btn {
  background: #2f80ed;
}

/* ---------- result ---------- */

.result-state {
  padding-top: 80rpx;
}

.result-card {
  padding: 48rpx 36rpx;
  text-align: center;
}

.result-label {
  font-size: 28rpx;
  color: #8a8f99;
}

.result-time {
  margin-top: 12rpx;
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 1rpx;
  color: #111111;
}

.time-unit {
  margin-left: 10rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #8a8f99;
}

.result-error {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #6b7280;
}

.tier {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.1);
  color: #2f80ed;
  font-size: 30rpx;
  font-weight: 600;
}

.best-block {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #f0f1f3;
}

.new-best {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.best-line {
  font-size: 26rpx;
  line-height: 1.8;
  color: #8a8f99;
}

.invalid-tip {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #ff4d4f;
}
