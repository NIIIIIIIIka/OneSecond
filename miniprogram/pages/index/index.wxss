/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.state { flex: 1; display: flex; flex-direction: column; }

/* ---------- 通用 ---------- */
.card {
  padding: 32rpx;
  border: 1rpx solid rgba(20, 23, 31, 0.04);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 40rpx rgba(35, 48, 72, 0.06);
}
.card-label { font-size: 24rpx; color: #8b92a1; }
.target-pill {
  display: inline-block;
  margin-top: 28rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(72, 112, 210, 0.16);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4267c9;
  background: #edf2ff;
}
.footer { margin-top: auto; padding-top: 36rpx; }
.primary-btn {
  width: 100%; height: 104rpx; line-height: 104rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #587ce8, #4164cf);
  box-shadow: 0 14rpx 30rpx rgba(65, 100, 207, 0.22);
  color: #fff; font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx;
  transition: opacity .15s ease, transform .15s ease;
}
.primary-btn:active, .share-btn:active, .ranking-link:active, .ranking-entry:active { opacity: .84; transform: scale(.98); }
.primary-actions { display: flex; align-items: stretch; }
.primary-actions .primary-btn,
.share-btn {
  display: flex; flex: 1 1 0; align-items: center; justify-content: center;
  width: 0; height: 104rpx; margin: 0; padding: 0;
  border-radius: 28rpx; box-sizing: border-box;
  font-size: 32rpx; font-weight: 600; line-height: 1.2; letter-spacing: 1rpx;
  transition: opacity .15s ease, transform .15s ease;
}
.primary-actions .primary-btn {
  background: linear-gradient(135deg, #587ce8, #4164cf);
  box-shadow: 0 14rpx 30rpx rgba(65, 100, 207, 0.22);
  color: #fff;
}
.share-btn {
  margin-left: 16rpx; border: 1rpx solid rgba(74, 110, 211, .14);
  background: #eef2fb; box-shadow: none; color: #365ab9;
}
.share-btn::after { border: none; }
.action-icon {
  display: flex; align-items: center; justify-content: center;
  width: 34rpx; height: 34rpx; margin-right: 10rpx;
  border-radius: 50%; background: #fff; color: #4267c9;
  font-size: 21rpx; line-height: 1;
}
.action-icon-primary { background: rgba(255, 255, 255, .18); color: #fff; }
.ranking-link {
  display: flex; align-items: center; justify-content: center;
  min-height: 72rpx; margin-top: 10rpx;
  font-size: 24rpx; color: #818a99;
}
.ranking-link-arrow { margin-left: 6rpx; color: #a0a6b1; font-size: 28rpx; }
.precision-tip { margin-top: 18rpx; text-align: center; font-size: 22rpx; color: #adb2bd; }
.sync-chip {
  display: inline-block; margin-top: 14rpx; padding: 5rpx 16rpx;
  border-radius: 999rpx; background: #f1f3f6; color: #8b92a1; font-size: 21rpx;
}

/* ---------- idle ---------- */
.hero { padding: 18rpx 8rpx 36rpx; }
.hero-eyebrow, .state-kicker {
  margin-bottom: 14rpx; font-size: 20rpx; font-weight: 600;
  letter-spacing: 4rpx; color: #6c87d8;
}
.hero-title { font-size: 66rpx; font-weight: 750; line-height: 1.15; letter-spacing: 1rpx; color: #14171f; }
.hero-subtitle { margin-top: 14rpx; font-size: 30rpx; color: #7f8796; }
.best-card { margin-bottom: 20rpx; }
.best-value {
  margin-top: 12rpx; font-size: 54rpx; font-weight: 700; line-height: 1.2;
  color: #14171f; font-variant-numeric: tabular-nums;
}
.best-value .unit { margin-left: 7rpx; font-size: 26rpx; font-weight: 400; color: #8b92a1; }
.best-detail, .best-empty { margin-top: 8rpx; font-size: 25rpx; color: #8b92a1; }
.best-empty { margin-top: 12rpx; font-size: 29rpx; color: #a5aab5; }
.ranking-entry { transition: opacity .15s ease, transform .15s ease; }
.ranking-entry-card {
  display: flex; align-items: center; margin-bottom: 20rpx; padding: 24rpx 28rpx;
  border-radius: 24rpx; background: #eef2fb;
}
.ranking-entry-icon { width: 56rpx; font-size: 32rpx; }
.ranking-entry-copy { flex: 1; min-width: 0; }
.ranking-entry-title { font-size: 28rpx; font-weight: 600; color: #202633; }
.ranking-entry-note { margin-top: 5rpx; font-size: 22rpx; color: #8b92a1; }
.ranking-entry-arrow { margin-left: 16rpx; font-size: 40rpx; line-height: 1; color: #7890cf; }
.rule-card { box-shadow: none; background: rgba(255, 255, 255, .68); }
.rule-title { font-size: 27rpx; font-weight: 600; color: #202633; }
.rule-text { margin-top: 12rpx; font-size: 25rpx; line-height: 1.72; color: #707887; }

/* ---------- ready / running ---------- */
.ready-state, .running-state { align-items: center; justify-content: center; text-align: center; }
.state-kicker { margin-bottom: 18rpx; }
.ready-title, .running-title { font-size: 60rpx; font-weight: 700; color: #14171f; }
.ready-hint, .running-hint { margin-top: 18rpx; font-size: 28rpx; color: #8b92a1; }
.pulse-dot {
  width: 22rpx; height: 22rpx; margin-bottom: 28rpx; border: 10rpx solid #ffe3e1;
  border-radius: 50%; background: #f15b57; box-shadow: 0 0 0 12rpx rgba(241, 91, 87, .08);
}
.action-btn {
  flex-shrink: 0;
  width: 420rpx;
  min-width: 420rpx;
  max-width: 420rpx;
  height: 420rpx;
  min-height: 420rpx;
  max-height: 420rpx;
  margin: 52rpx auto 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 4rpx;
  transition: opacity .15s ease, transform .15s ease, box-shadow .15s ease;
}
.action-btn:active {
  opacity: .9;
  transform: scale(.95);
  box-shadow: 0 8rpx 18rpx rgba(35, 48, 72, .16);
}
.instant-btn {
  background: linear-gradient(145deg, #ff7770, #e84b48);
  box-shadow: 0 20rpx 46rpx rgba(234, 79, 76, .28), inset 0 2rpx 0 rgba(255, 255, 255, .2);
}
.ready-btn {
  background: linear-gradient(145deg, #6285ed, #3f61ca);
  box-shadow: 0 20rpx 46rpx rgba(65, 100, 207, .28), inset 0 2rpx 0 rgba(255, 255, 255, .2);
}

/* ---------- result ---------- */
.result-state { padding-top: 22rpx; }
.result-card { padding: 42rpx 32rpx 32rpx; text-align: center; }
.result-label { font-size: 25rpx; color: #7f8796; }
.result-time {
  margin-top: 10rpx; font-size: 90rpx; font-weight: 750; line-height: 1.12;
  letter-spacing: -1rpx; color: #10131a; font-variant-numeric: tabular-nums;
}
.time-unit { margin-left: 8rpx; font-size: 36rpx; font-weight: 650; }
.result-verdict { margin-top: 20rpx; font-size: 30rpx; font-weight: 550; color: #16834b; }
.result-direction { margin-top: 8rpx; font-size: 22rpx; color: #a0a6b1; }
.best-block { margin-top: 24rpx; }
.new-best {
  display: inline-block; margin-bottom: 12rpx; padding: 7rpx 18rpx;
  border-radius: 999rpx; background: #fff3d6; color: #a56c05; font-size: 22rpx; font-weight: 650;
}
.best-line { font-size: 24rpx; line-height: 1.7; color: #747c8a; }
.rank-feedback {
  margin-top: 18rpx; padding: 26rpx 28rpx; border-radius: 26rpx;
  background: #eef2fb; text-align: left;
}
.rank-feedback-header, .rank-feedback-main { display: flex; align-items: baseline; justify-content: space-between; }
.rank-feedback-title { font-size: 23rpx; color: #7f8796; }
.rank-feedback-link { font-size: 22rpx; color: #526fc3; }
.rank-feedback-main { justify-content: flex-start; margin-top: 12rpx; }
.rank-feedback-rank { font-size: 36rpx; font-weight: 700; color: #181d28; }
.rank-feedback-percent { margin-left: 16rpx; font-size: 24rpx; color: #65718a; }
.rank-feedback-gap { margin-top: 9rpx; font-size: 27rpx; font-weight: 600; color: #4267c9; }
.rank-feedback-best, .rank-feedback-only, .rank-feedback-muted { margin-top: 7rpx; font-size: 22rpx; color: #8b92a1; }
.rank-feedback-muted { margin-top: 14rpx; font-size: 25rpx; }
.rank-retry { margin-left: 12rpx; color: #526fc3; }
.invalid-tip { margin-top: 18rpx; font-size: 24rpx; color: #d94b48; }
