/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.state {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ---------- idle ---------- */

.hero {
  padding: 16rpx 8rpx 44rpx;
}

.hero-title {
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #111111;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 32rpx;
  color: #8a8f99;
}

.target-pill {
  display: inline-block;
  margin-top: 32rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2f80ed;
  background: rgba(47, 128, 237, 0.1);
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 17, 17, 0.04);
}

.best-card {
  margin-bottom: 24rpx;
}

.card-label {
  font-size: 26rpx;
  color: #8a8f99;
}

.best-value {
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #111111;
}

.best-value .unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #8a8f99;
}

.best-empty {
  margin-top: 14rpx;
  font-size: 32rpx;
  color: #b0b4bb;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}

.rule-text {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #6b7280;
}

.footer {
  margin-top: auto;
  padding-top: 48rpx;
}

.primary-btn {
  width: 100%;
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 999rpx;
  background: #2f80ed;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.primary-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.precision-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
}

/* ---------- running ---------- */

.running-state {
  align-items: center;
  justify-content: center;
  text-align: center;
}

.running-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #111111;
}

.running-hint {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #8a8f99;
}

.stop-btn {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  margin-top: 120rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.stop-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---------- result ---------- */

.result-state {
  padding-top: 80rpx;
}

.result-card {
  padding: 44rpx 36rpx;
  text-align: center;
}

.error-value {
  margin-top: 10rpx;
  font-size: 110rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #111111;
}

.error-value .error-unit {
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #8a8f99;
}

.tier {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #2f80ed;
}

.result-lines {
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #f0f1f3;
}

.result-line {
  font-size: 28rpx;
  line-height: 1.9;
  color: #6b7280;
}

.result-line .strong {
  color: #111111;
  font-weight: 600;
}

.new-best {
  display: inline-block;
  margin-top: 26rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.1);
  color: #2f80ed;
  font-size: 26rpx;
  font-weight: 600;
}

.muted-line {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: #b0b4bb;
}

.best-line {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.invalid-tip {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #ff4d4f;
}
